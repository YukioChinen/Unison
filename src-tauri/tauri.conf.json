{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unison",
  "version": "0.1.0",
  "identifier": "com.unison.peripherals",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Unison",
        "create": false,
        "visible": false,
        "width": 980,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
